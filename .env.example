# auto-content 环境变量模板
# 用法：复制成 .env 再填值。.env 不会进仓库（.gitignore 已排除）。
# 服务器上的路径：/opt/auto-content/.env

# ---- 必填 ----
# 审核后台的访问密码（打开网页、复制成品都要它）
APP_PASSWORD=换成你的密码
# 审核页手机可访问的公网地址，ServerChan 推送里会带上这个链接
# 换端口时这里也要带端口，例如 http://1.2.3.4:8080
REVIEW_URL=https://你的域名或IP

# 审核后台监听端口，默认 5000。同机已有别的项目占着 5000 时改成 5001 等。
# 改完要同步两处：nginx 的 proxy_pass、上面的 REVIEW_URL。
APP_PORT=5000

# ---- AI 写作 ----
# 用哪家模型：zhipu（默认，免费）/ deepseek（按量付费，约 ¥5-15/月）/ siliconflow
# 换平台只改这一行，不用动代码。key 按下面各自的名字填。
AI_PROVIDER=zhipu

# 智谱开放平台的 API Key，写作和配图都用它
# 申请：https://open.bigmodel.cn
AI_API_KEY=你的智谱key
# 智谱 key 的专用变量名（和 AI_API_KEY 二选一，这个优先）
ZHIPU_API_KEY=

# 用 DeepSeek 时填这个（申请：https://platform.deepseek.com）
# 模型名现在是 deepseek-flash，老教程里的 deepseek-chat 已于 2026-07 下线
DEEPSEEK_API_KEY=

# 深度思考开关，默认 0（关）。写稿不需要推理，开着更慢更贵。
AI_THINKING=0

# 单次请求超时秒数，长稿建议 240
AI_TIMEOUT=240

# Flask session 签名密钥（随便一串长随机字符，改了会导致已登录状态失效）
SECRET_KEY=随便一串32位以上随机字符

# ---- 推送通知（可选）----
# ServerChan 推送 key，不填就只是不推送
SERVERCHAN_KEY=

# ---- 署名（可选）----
# 成品预览和公众号草稿里的作者名，也可以直接改 config.SITE_AUTHOR
SITE_AUTHOR=Plan B 的AI笔记

# ---- 排版增强（可选）----
# 给裸文本加 <span leaf=""> 包裹，1 开启。默认 0。
WECHAT_LEAF_WRAP=0
# 相邻两节之间插一条极淡的分隔线（#eceff4），1 开启，默认开。嫌啰嗦改 0。
WECHAT_SECTION_DIVIDER=1
# 正文末尾是否保留「信息来源：公众号·某某」出处标注。默认 0 不显示——
# 挂着别人的号名会把读者引走；确有合规需要时改 1 恢复。
SHOW_SOURCE_NOTE=0

# ---- 公众号头图（可选）----
# 1=先让文本模型按文章写一句画面脚本再出图（更贴合文章，每篇多几厘钱）
# 0=只用关键词规则出图（不额外调用模型，但同类文章容易撞图）
COVER_BRIEF=1

# ---- 三条内容线的每日排期 ----
# 每天自动生成后进待审队列，由你逐条审核，不自动发布：
#   AI早报 5 条 + AI副业 2 条（每天）
#   GitHub精选 到期当天再多 1 条（默认每 3 天一次）
# 想改数量就改前两个；不想自动出某个栏目写 0。
DAILY_NEWS_COUNT=5
DAILY_SIDE_BIZ_COUNT=2

# ---- GitHub 深度专栏（可选，默认开启）----
# 每 3 天 1 篇「一期讲透一个高星标开源项目」，格式统一为
# 「是什么 + 能帮你做什么 + 怎么用（可复制命令）+ 谁适合用」。
# 上次生成日期单独记在 data/column_state.json，不受待审稿 3 天清理影响。
# 同一项目推荐过一次后不再重复；star 低于门槛的候选会被过滤。
# 想关掉整个栏目写 USE_GITHUB_COLUMN=0；想改周期改 INTERVAL_DAYS。
USE_GITHUB_COLUMN=1
DAILY_GITHUB_COLUMN=1
GITHUB_COLUMN_INTERVAL_DAYS=3
GITHUB_COLUMN_MIN_STARS=1000

# ---- 审核页栏目筛选（无需配置，仅说明）----
# 每篇稿自动生成时打上 column 标记，审核页三个筛选项对应：
#   github=GitHub精选（上面的专栏）/ ai_news=AI早报 / ai_sidebiz=AI副业
# 非专栏稿按标题/摘要是否命中副业词自动归入 AI副业，其余归 AI早报；
# 判定词在 config.SIDE_BIZ_KEYWORDS，要改直接改那里。
# 老稿件没有标记时，审核页按同一规则临时归类显示，不改原文件。

# ---- 选题源（可选）----
# 用 DailyHotApi 聚合多平台热榜，1 开启。开启前先跑：
#   python hot_topics.py --check dailyhot
USE_DAILYHOT=0
# 自建实例地址，多个用逗号分隔，按顺序尝试
DAILYHOT_BASES=https://api-hot.imsyy.top
# 搜狗微信搜索词（抓同行在写的文章当选题），逗号分隔；只取前 3 个，别超。
# 默认值已含 AI副业 / 被动收入 方向；要覆盖就在 .env 里写这一行：
# WECHAT_SEARCH_KEYWORDS=AI 副业,AI 工具,被动收入

# ---- 微信公众号草稿箱（可选）----
# 配了才能在审核页「推到草稿箱」。不配就继续用复制粘贴。
# 未认证的个人订阅号也能用（实测草稿接口 1000 次/日），只有"发布/群发"不行。
# 位置（2025-12-01 起搬家了，不在 mp.weixin.qq.com 的「基本配置」）：
#   developers.weixin.qq.com/platform → 我的业务 → 选公众号 → 基础信息 / 开发密钥
#   AppSecret 只显示一次，忘了只能重置（重置会让别处旧密钥立刻失效）。
# 还要在同一个页面把服务器出口 IP 加进「IP 白名单」，否则取 token 就报 40164。
# 当前服务器出口 IP：82.157.4.72（没有 IPv6，只加这一条即可）。
WECHAT_APPID=
WECHAT_SECRET=

# ---- 画像 / 日历 / 多平台（无需配置，仅说明）----
# 账号画像存 data/profile.json（审核页「账号画像」面板可编辑，改完下次生成生效）；
# 复盘数据存 data/analytics.json；这两个文件都不随 git 同步，换机要单独拷。
# 内容日历的节日表内置在 content_calendar.py；要加自定义节日，
# 在 data/holidays.json 写 [{"date":"MM-DD","name":"节日名"}]，会覆盖同名内置项。
# 多平台复制在卡片上选平台即可：公众号=完整样式，头条号/百家号=简洁档。
