# 密钥与隐私配置——绝不上传
.env
.env.*
*.env
# 但变量模板要进仓库（里面只有变量名，没有值）
!.env.example

# 运行期数据（含生成稿件、日志、备份）
data/queue.json
data/*.json
data/*.log
data/*.bak*

# 生成产物：头图、本地样张，不入库
output/
data/covers/

# 头条号/百家号登录态（浏览器 profile 含 cookie，绝不入库）与扫码二维码
data/toutiao_profile/
data/toutiao_qr.png
data/toutiao_cookies.json
data/baijia_profile/
data/baijia_qr.png
data/baijia_cookies.json

# 含真实服务器信息的本地运维备份
DEPLOYED.local.bak
*.local.*

# 部署前的目录级备份（服务器上按 YYYYMMDD_HHMM_说明 命名，只留 3 份）
.backups/

# 工作日志（项目内部记录，不入库）
.workbuddy/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 虚拟环境
venv/
.venv/
env/
